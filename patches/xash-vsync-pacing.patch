diff -ruN a/engine/platform/apple/pacing_apple.c b/engine/platform/apple/pacing_apple.c
--- a/engine/platform/apple/pacing_apple.c
+++ b/engine/platform/apple/pacing_apple.c
@@ -0,0 +1,166 @@
+/*
+pacing_apple.c - presentation feedback for low-latency VSync pacing
+Copyright (C) 2026 Brutal Half-Life macOS port contributors
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+*/
+#include "common.h"
+#include "platform/platform.h"
+#include <objc/runtime.h>
+#include <objc/message.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <time.h>
+
+// The renderer (ANGLE's Metal backend) acquires one CAMetalLayer drawable per
+// frame. Counting acquisitions and Metal's presentation callbacks tells the
+// engine how many finished frames are still waiting for the display, with no
+// renderer changes and no assumptions about compositor deadlines.
+static IMP pacing_next_drawable;
+static _Atomic uint64_t pacing_acquired, pacing_presented;
+static _Atomic double pacing_last_presented, pacing_period;
+static pthread_mutex_t pacing_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t pacing_changed = PTHREAD_COND_INITIALIZER;
+static qboolean pacing_hooked;
+
+static void Pacing_Presented( id drawable )
+{
+	double ( *presented_time )( id, SEL ) = (void *)objc_msgSend;
+	double when = presented_time( drawable, sel_registerName( "presentedTime" ));
+
+	// presentedTime is 0 for a drawable that was discarded; it still leaves the queue
+	if( when > 0.0 )
+	{
+		double last = atomic_load_explicit( &pacing_last_presented, memory_order_relaxed );
+		double period = atomic_load_explicit( &pacing_period, memory_order_relaxed );
+		double delta = when - last;
+
+		// consecutive presentations are whole refreshes apart: track the
+		// shortest interval, smoothing small timestamp jitter
+		if( last > 0.0 && delta > 0.002 && delta < 0.1 )
+		{
+			if( period <= 0.0 || delta < period * 0.75 )
+				period = delta;
+			else if( delta < period * 1.25 )
+				period += ( delta - period ) * 0.05;
+			atomic_store_explicit( &pacing_period, period, memory_order_relaxed );
+		}
+
+		atomic_store_explicit( &pacing_last_presented, when, memory_order_relaxed );
+	}
+
+	pthread_mutex_lock( &pacing_lock );
+	atomic_fetch_add_explicit( &pacing_presented, 1, memory_order_release );
+	pthread_cond_broadcast( &pacing_changed );
+	pthread_mutex_unlock( &pacing_lock );
+}
+
+static id Pacing_NextDrawable( id layer, SEL cmd )
+{
+	id drawable = (( id (*)( id, SEL ))pacing_next_drawable )( layer, cmd );
+
+	if( drawable )
+	{
+		void ( *add_handler )( id, SEL, void ( ^ )( id )) = (void *)objc_msgSend;
+
+		atomic_fetch_add_explicit( &pacing_acquired, 1, memory_order_release );
+		add_handler( drawable, sel_registerName( "addPresentedHandler:" ), ^( id shown ) { Pacing_Presented( shown ); });
+	}
+
+	return drawable;
+}
+
+static qboolean Pacing_Hook( void )
+{
+	Class layer;
+	Method method;
+
+	if( pacing_hooked )
+		return true;
+
+	layer = objc_getClass( "CAMetalLayer" );
+	method = layer ? class_getInstanceMethod( layer, sel_registerName( "nextDrawable" )) : NULL;
+
+	if( !method )
+		return false;
+
+	pacing_next_drawable = method_setImplementation( method, (IMP)Pacing_NextDrawable );
+	pacing_hooked = true;
+	Con_Reportf( "Presentation feedback pacing enabled\n" );
+	return true;
+}
+
+/*
+==================
+Pacing_WaitForQueue
+
+Blocks until no more than "queued" finished frames are waiting for the
+display, or the timeout passes. Returns the number still queued, or -1 when
+presentation feedback is unavailable.
+==================
+*/
+int Pacing_WaitForQueue( int queued, double timeout )
+{
+	struct timespec deadline;
+	int64_t pending;
+
+	if( !Pacing_Hook( ))
+		return -1;
+
+	clock_gettime( CLOCK_REALTIME, &deadline );
+	deadline.tv_nsec += (long)( timeout * 1e9 );
+	deadline.tv_sec += deadline.tv_nsec / 1000000000;
+	deadline.tv_nsec %= 1000000000;
+
+	pthread_mutex_lock( &pacing_lock );
+
+	for( ;; )
+	{
+		pending = (int64_t)( atomic_load( &pacing_acquired ) - atomic_load( &pacing_presented ));
+
+		if( pending <= queued || pthread_cond_timedwait( &pacing_changed, &pacing_lock, &deadline ))
+			break;
+	}
+
+	pending = (int64_t)( atomic_load( &pacing_acquired ) - atomic_load( &pacing_presented ));
+
+	// a drawable that never reports back (window hidden, resized) must not
+	// stall later frames: forget it after a timeout
+	if( pending > queued )
+		atomic_store( &pacing_presented, atomic_load( &pacing_acquired ) - queued );
+
+	pthread_mutex_unlock( &pacing_lock );
+	return (int)pending;
+}
+
+/*
+==================
+Pacing_LastPresented
+
+Media-clock (CACurrentMediaTime) time of the most recent presented frame.
+==================
+*/
+double Pacing_LastPresented( void )
+{
+	return atomic_load_explicit( &pacing_last_presented, memory_order_relaxed );
+}
+
+/*
+==================
+Pacing_RefreshPeriod
+
+Display refresh period measured from presentations, or 0 when unknown.
+==================
+*/
+double Pacing_RefreshPeriod( void )
+{
+	return atomic_load_explicit( &pacing_period, memory_order_relaxed );
+}
