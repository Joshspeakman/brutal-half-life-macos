+#if XASH_OSX && !XASH_DEDICATED
 /*
 ===================
+Host_PaceToDisplay
+
+With VSync, the swap chain otherwise lets the game run two frames ahead of the
+display, adding latency without adding smoothness. Before a single-player frame
+samples input, wait until at most host_vsync_queue finished frames are still
+waiting for the display, using Metal's own presentation callbacks. One queued
+frame keeps the smoothness of buffering while removing a frame of latency.
+Returns false when pacing does not apply.
+===================
+*/
+static qboolean Host_PaceToDisplay( void )
+{
+	static int trace = -1;
+	static unsigned traced;
+	double before, waited;
+	int pending;
+
+	if( !host_vsync_pacing.value || !gl_vsync.value || !Host_IsSinglePlayerGame() || CL_IsPlaybackDemo() || CL_IsRecordDemo() || host.status != HOST_FRAME )
+		return false;
+
+	before = Platform_DoubleTime();
+	pending = Pacing_WaitForQueue( bound( 0, (int)host_vsync_queue.value, 2 ), 0.05 );
+	waited = Platform_DoubleTime() - before;
+
+	// diagnostic: BHL_PACING_TRACE=1 logs each wait on the engine clock
+	if( trace < 0 )
+		trace = getenv( "BHL_PACING_TRACE" ) != NULL;
+	if( trace && traced++ < 20000 )
+		fprintf( stderr, "BHL_PACE %.6f %.6f %d %.6f\n", before, waited, pending, Pacing_LastPresented( ));
+
+	return pending >= 0;
+}
+#endif
