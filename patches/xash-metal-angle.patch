+// Remember the original RGB/RGBA distinction after GLES converts uploads to RGBA.
+// It controls REPLACE/DECAL alpha behavior. Texture names can be any GLuint.
+typedef struct gl2_texinfo_s
+{
+	GLuint name;
+	GLboolean alpha;
+	struct gl2_texinfo_s *next;
+} gl2_texinfo_t;
+static gl2_texinfo_t *gl2_textures[256];
+static gl2_texinfo_t *GL2_TextureInfo( GLuint name, qboolean create )
+{
+	unsigned bucket = name % ARRAYSIZE( gl2_textures );
+	gl2_texinfo_t *p;
+	for( p = gl2_textures[bucket]; p; p = p->next )
+		if( p->name == name ) return p;
+	if( !create ) return NULL;
+	p = Mem_Calloc( r_temppool, sizeof( *p ));
+	p->name = name; p->alpha = GL_TRUE;
+	p->next = gl2_textures[bucket]; gl2_textures[bucket] = p;
+	return p;
+}
