+
+/* Native adapters may cache absent models only while this revision agrees.
+ * Every client-table edit and model-name lifetime change invalidates it. */
+static uint64_t model_lookup_revision = 1;
+void Mod_InvalidateModelLookup( void )
+{
+	if( !++model_lookup_revision ) Sys_Error( "Model lookup revision overflow" );
+}
+uint64_t EXPORT Xash_GetModelLookupRevisionV1( void )
+{
+	return model_lookup_revision;
+}
 
